# Expo SDK 57 pins React 19.2.3, but jest-expo peer-requires
# react-server-dom-webpack@~19.2.4, which in turn peer-requires react ^19.2.4.
# That contradiction sends npm's peer resolver into an exponential backtrack
# that never terminates. Relaxing strict peer resolution is the documented
# workaround and keeps installs reproducible for everyone on the team.
legacy-peer-deps=true

# Generous network timeouts: large RN tarballs on a slow link otherwise trip
# npm's idle timeout and roll the whole install back.
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
maxsockets=8
