# ---------------------------------------------------------------------------
# Speakora environment configuration
#
# 1. Copy this file to `.env`:      cp .env.example .env
# 2. Fill in your Gemini API key:   https://aistudio.google.com/apikey
# 3. Restart Metro with a clear cache: npm run start:clear
#
# `.env` is git-ignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# Which AI provider the app talks to. Currently supported: "gemini".
AI_PROVIDER=gemini

# Your Google AI Studio API key.
GEMINI_API_KEY=

# Model used for conversation + analysis.
GEMINI_MODEL=gemini-2.5-flash

# Override only if you are proxying Gemini.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OPTIONAL. When set, the app routes every AI call through your own backend
# gateway instead of calling Gemini directly, and GEMINI_API_KEY is not
# embedded in the binary. This is the recommended production setup.
# Example: https://api.yourdomain.com/ai
AI_GATEWAY_URL=

# Network timeout for a single AI request, in milliseconds.
AI_REQUEST_TIMEOUT_MS=30000

# One of: debug | info | warn | error | silent
LOG_LEVEL=info
